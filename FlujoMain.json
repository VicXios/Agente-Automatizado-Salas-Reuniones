    {
      "parameters": {
        "jsCode": "const reservasExistentes = $(\"Revisar reservas\").all().map(item => item.json);\n\nfunction horaEnMinutos(horaStr) {\n  horaStr = horaStr.trim().toLowerCase();\n\n  // Caso 1: formato con am/pm → \"10:00:00 a.m.\"\n  if (horaStr.includes(\"a.m.\") || horaStr.includes(\"p.m.\")) {\n    const [time, meridian] = horaStr.split(\" \");\n    const [hStr, mStr, sStr] = time.split(\":\");\n\n    let horas = parseInt(hStr, 10);\n    const minutos = parseInt(mStr, 10);\n    const segundos = sStr ? parseInt(sStr, 10) : 0;\n\n    if (meridian === \"p.m.\" && horas !== 12) {\n      horas += 12;\n    }\n    if (meridian === \"a.m.\" && horas === 12) {\n      horas = 0;\n    }\n\n    return horas * 60 + minutos + Math.floor(segundos / 60);\n  }\n\n  // Caso 2: formato 24 horas → \"10:00\" o \"14:00\"\n  const [hStr, mStr] = horaStr.split(\":\");\n  const horas = parseInt(hStr, 10);\n  const minutos = parseInt(mStr, 10);\n\n  return horas * 60 + minutos;\n}\n\n\n\nfunction normalizarFecha(fechaStr) {\n  fechaStr = fechaStr.trim();\n\n  // Caso 1: formato DD/MM/YYYY → \"20/12/2025\"\n  if (fechaStr.includes(\"/\")) {\n    const [dia, mes, anio] = fechaStr.split(\"/\");\n    return new Date(`${anio}-${mes.padStart(2,\"0\")}-${dia.padStart(2,\"0\")}`);\n  }\n\n  // Caso 2: formato YYYY-MM-DD → \"2025-12-20\"\n  if (fechaStr.includes(\"-\")) {\n    return new Date(fechaStr);\n  }\n\n  throw new Error(\"Formato de fecha no reconocido: \" + fechaStr);\n}\n\n\n\n\nfunction validarReserva(reservas) {\n  const inicio = horaEnMinutos($input.first().json['Hora de inicio']);\n  const fin = horaEnMinutos($input.first().json['Hora fin']);\n  const fecha = normalizarFecha($input.first().json['Fecha de la reunión']);\n  \n  for (let index = 0; index < reservas.length; index++) {\n    const r = reservas[index];\n    if(r.Sala === $input.first().json['Selecciona una sala'] && fin > horaEnMinutos(r.HoraInicio) && inicio < horaEnMinutos(r.HoraFin) && fecha.getDate() === normalizarFecha(r.Fecha).getDate()){\n      return false;\n    }\n  }\n  return true;\n}\n\n\n\n\nfunction convertirFecha(fechaStr) {\n  const [dia, mes, anio] = fechaStr.split(\"/\");\n  return `${anio}-${mes.padStart(2, \"0\")}-${dia.padStart(2, \"0\")}`;\n}\n\nfunction minutosAHora(minutos) {\n  const horas = Math.floor(minutos / 60);\n  const mins = minutos % 60;\n\n  // Formateamos con dos dígitos\n  const horasStr = String(horas).padStart(2, \"0\");\n  const minsStr = String(mins).padStart(2, \"0\");\n\n  return `${horasStr}:${minsStr}`;\n}\n\nconst resultado = validarReserva(reservasExistentes);\nconst date = convertirFecha($input.first().json['Fecha de la reunión']);\n\nconst inicio = horaEnMinutos($input.first().json['Hora de inicio'])\nconst fin = horaEnMinutos($input.first().json['Hora fin'])\nconst HoraInicio = minutosAHora(inicio)\nconst HoraFin = minutosAHora(fin)\n\n\nreturn {\n  resultado,\n  sala: $input.first().json['Selecciona una sala'],\n  date,\n  HoraInicio,\n  HoraFin\n};\n"
      },
