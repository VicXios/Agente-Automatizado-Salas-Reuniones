    {
      "parameters": {
        "jsCode": "\nconst data = items.map(item => item.json);\n\n// Normaliza horas a formato 24h para comparación\nfunction parseHora(horaStr) {\n  if (!horaStr || typeof horaStr !== 'string') return null;\n\n  const partes = horaStr.trim().split(' ');\n  if (partes.length < 2) return null;\n\n  const [time, meridian] = partes;\n  const [hoursStr, minutesStr] = time.split(':');\n  if (!hoursStr || !minutesStr || !meridian) return null;\n\n  let hours = parseInt(hoursStr, 10);\n  let minutes = parseInt(minutesStr, 10);\n\n  const meridianLower = meridian.toLowerCase();\n  if (meridianLower === 'p.m.' && hours < 12) hours += 12;\n  if (meridianLower === 'a.m.' && hours === 12) hours = 0;\n\n  return hours * 60 + minutes;\n}\n\n// Extrae filtros si están presentes\nconst horaInicio = parseHora($('Datos formulario').first().json.body.inicio);\nconst horaFin = parseHora($('Datos formulario').first().json.body.fin);\nconst salaSolicitada = $('Datos formulario').first().json.body.sala;\nconst participantesSolicitados = parseInt($('Datos formulario').first().json.body.participantes, 10);\n\n// Aplica filtros si están definidos\nconst filtrado = data.filter(row => {\n  const apertura = parseHora(row[\"Hora apertura\"]);\n  const cierre = parseHora(row[\"Hora cierre\"]);\n  const capacidadSala = parseInt(row.MaxParticipantes, 10);\n\n  const cumpleHora = (!horaInicio || !horaFin || (apertura <= horaInicio && cierre >= horaFin));\n  const cumpleSala = (!salaSolicitada || row.Salas === salaSolicitada);\n  const cumpleCapacidad = (!participantesSolicitados || capacidadSala >= participantesSolicitados);\n\n  return cumpleHora && cumpleSala && cumpleCapacidad;\n});\n\n// Genera HTML\nlet html = `<table border=\"1\" cellpadding=\"5\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n  <thead>\n    <tr>\n      <th>Salas</th>\n      <th>MaxParticipantes</th>\n      <th>Hora apertura</th>\n      <th>Hora cierre</th>\n    </tr>\n  </thead>\n  <tbody>`;\n\nfor (const row of filtrado) {\n  html += `<tr>\n    <td>${row.Salas}</td>\n    <td>${row.MaxParticipantes}</td>\n    <td>${row[\"Hora apertura\"]}</td>\n    <td>${row[\"Hora cierre\"]}</td>\n  </tr>`;\n}\n\nhtml += `</tbody></table>`;\n\nreturn [{ json: { html } }];\n"
      },
