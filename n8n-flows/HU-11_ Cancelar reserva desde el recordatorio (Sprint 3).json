    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\n\n// Cambiar esta URL por la del webhook de respuesta cuando se integre el flujo\nconst baseUrl = 'http://localhost:5678/webhook-test/reservas/respuesta';\n\nconst confirmUrl = `${baseUrl}?action=confirm&id=${encodeURIComponent(r.ID)}`;\nconst cancelUrl  = `${baseUrl}?action=cancel&id=${encodeURIComponent(r.ID)}`;\n\nconst html = `\n  <div style=\"font-family: Arial, sans-serif; max-width: 600px;\">\n    <h2>Detalle de tu reserva</h2>\n    <p>Hola, te enviamos el resumen de tu reserva para confirmación:</p>\n\n    <table style=\"border-collapse: collapse; width: 100%; margin-bottom: 16px;\">\n      <tr>\n        <th style=\"border: 1px solid #ddd; padding: 8px;\">Sala</th>\n        <th style=\"border: 1px solid #ddd; padding: 8px;\">Fecha</th>\n        <th style=\"border: 1px solid #ddd; padding: 8px;\">Inicio</th>\n        <th style=\"border: 1px solid #ddd; padding: 8px;\">Fin</th>\n      </tr>\n      <tr>\n        <td style=\"border: 1px solid #ddd; padding: 8px;\">${r.Sala}</td>\n        <td style=\"border: 1px solid #ddd; padding: 8px;\">${r.Fecha}</td>\n        <td style=\"border: 1px solid #ddd; padding: 8px;\">${r.HoraInicio}</td>\n        <td style=\"border: 1px solid #ddd; padding: 8px;\">${r.HoraFin}</td>\n      </tr>\n    </table>\n\n    <p><strong>Título:</strong> ${r.Titulo || ''}</p>\n    <p><strong>Descripción:</strong><br>${r.Descripcion || ''}</p>\n\n    <p style=\"margin-top: 24px; margin-bottom: 8px;\">Por favor selecciona una opción:</p>\n\n    <div style=\"display: flex; gap: 12px; margin-bottom: 24px;\">\n      <a href=\"${confirmUrl}\" \n         style=\"background-color:#16a34a;color:white;padding:10px 16px;text-decoration:none;border-radius:4px;\">\n        Confirmar reserva\n      </a>\n      <a href=\"${cancelUrl}\" \n         style=\"background-color:#dc2626;color:white;padding:10px 16px;text-decoration:none;border-radius:4px;\">\n        Cancelar reserva\n      </a>\n    </div>\n\n    <p style=\"font-size: 12px; color: #555;\">Si no solicitaste esta reserva, ignora este correo.</p>\n  </div>\n`;\n\nreturn [\n  {\n    json: {\n      email: r.Correo,\n      subject: `Confirmación de reserva: ${r.Titulo || r.Sala}`,\n      html,\n      id_reserva: r.ID,\n    },\n  },\n];\n"
      },
