      "name": "Webhook - Recibir Reserva",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -1904,
        256
      ],
      "webhookDescription": "Recibe sala, fecha, horaInicio, horaFin, correo, titulo, descripcion",
      "webhookId": "ca13ae7b-95fc-4974-80ad-63ad82e04c8a"
    },
    {
      "parameters": {
        "functionCode": "// --- Entradas desde Google Sheets y Webhook ---\nconst reservas = Array.isArray(items) ? items : [items];\nconst nueva = $json;\n\n// --- Normalizar claves del webhook (sin importar mayúsculas, espacios ni formato) ---\nconst normalizarKeys = {};\nfor (const k of Object.keys(nueva)) {\n  normalizarKeys[k.toLowerCase().trim()] = nueva[k];\n}\n\n// --- Normalización de los datos del POST ---\nconst salaNueva = (normalizarKeys[\"sala\"] || \"\").toString().trim().toLowerCase();\nconst fechaNueva = (normalizarKeys[\"fecha\"] || \"\").toString().trim();\nconst horaInicioNueva = (normalizarKeys[\"horainicio\"] || \"\").toString().trim();\nconst horaFinNueva = (normalizarKeys[\"horafin\"] || \"\").toString().trim();\n\n// --- Función para convertir HH:MM (o HH:MM:SS) a minutos ---\nfunction toMinutes(hora) {\n  if (!hora) return 0;\n  const [h, m] = hora.toString().split(\":\").map(Number);\n  return (h || 0) * 60 + (m || 0);\n}\n\n// --- Validación de conflicto ---\nlet conflicto = false;\nlet conflictoData = null;\n\nfor (const raw of reservas) {\n  const item = raw.json;\n\n  const salaExistente = (item.Sala || \"\").toString().trim().toLowerCase();\n  const fechaExistente = (item.Fecha || \"\").toString().trim();\n  const horaInicioExistente = (item.HoraInicio || \"\").toString().trim();\n  const horaFinExistente = (item.HoraFin || \"\").toString().trim();\n\n  // --- Comparar sala y fecha ---\n  if (salaExistente === salaNueva && fechaExistente === fechaNueva) {\n    const inicioNueva = toMinutes(horaInicioNueva);\n    const finNueva = toMinutes(horaFinNueva);\n    const inicioExistente = toMinutes(horaInicioExistente);\n    const finExistente = toMinutes(horaFinExistente);\n\n    // --- Comprobar solapamiento de horarios ---\n    if (inicioNueva < finExistente && finNueva > inicioExistente) {\n      conflicto = true;\n      conflictoData = item;\n      break;\n    }\n  }\n}\n\n// --- Salida final ---\nreturn [\n  {\n    json: {\n      disponible: !conflicto,\n      mensaje: conflicto\n        ? `❌ La sala ya está reservada para esa fecha (${fechaNueva}) entre ${horaInicioNueva} y ${horaFinNueva}.`\n        : \"✅ La sala está disponible para reservar.\",\n      conflicto: conflictoData,\n      totalFilasLeidas: reservas.length,\n      debug: {\n        salaNueva,\n        fechaNueva,\n        horaInicioNueva,\n        horaFinNueva,\n        salasEnSheet: reservas.map(r => r.json.Sala)\n      }\n    }\n  }\n];\n"
      },
