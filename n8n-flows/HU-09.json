    {
      "parameters": {
        "jsCode": "const correo = $('Get datos solicitud').first().json['Correo administrador']\nconst nuevaSala = $('Get datos solicitud').first().json['Codigo de sala unico']\nconst capacidad = $('Get datos solicitud').first().json['Capacidad maxima de participantes']\nconst apertura = $('Get datos solicitud').first().json['Hora de apertura']\nconst cierre = $('Get datos solicitud').first().json['Hora de cierre']\nconst ubicacion = $('Get datos solicitud').first().json['Ubicacion (piso, edificio,sector)']\nconst eliminarSala = $('Get datos solicitud').first().json['Codigo sala a eliminar']\n\n// Función auxiliar para verificar si un campo tiene valor\nfunction tieneDato(valor) {\n  return valor !== undefined && valor !== null && String(valor).trim() !== '';\n}\n\nlet tipoSolicitud = \"incompleto\";\n\n// Caso AGREGAR: todos los campos de agregar tienen datos y eliminarSala está vacío\nif (\n  tieneDato(correo) &&\n  tieneDato(nuevaSala) &&\n  tieneDato(capacidad) &&\n  tieneDato(apertura) &&\n  tieneDato(cierre) &&\n  tieneDato(ubicacion) &&\n  !tieneDato(eliminarSala)\n) {\n  tipoSolicitud = \"agregar\";\n}\n\n// Caso ELIMINAR: correo y eliminarSala tienen datos y el resto está vacío\nelse if (\n  tieneDato(correo) &&\n  tieneDato(eliminarSala) &&\n  !tieneDato(nuevaSala) &&\n  !tieneDato(capacidad) &&\n  !tieneDato(apertura) &&\n  !tieneDato(cierre) &&\n  !tieneDato(ubicacion)\n) {\n  tipoSolicitud = \"eliminar\";\n}\n\n// En cualquier otro escenario → incompleto\nreturn [\n  {\n    json: {\n      ...$(\"Get datos solicitud\").first().json,\n      tipoSolicitud\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        0
      ],
      "id": "b65d2a64-4de5-4e45-aabd-82cd6ea926b0",
