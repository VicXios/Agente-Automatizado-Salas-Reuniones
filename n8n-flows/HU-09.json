    {
      "parameters": {
        "jsCode": "const salaEliminar = $('Get datos solicitud').first().json['Codigo sala a eliminar'];\n\n// Obtener todos los items del nodo \"Get lista salas\"\nconst itemsSalas = $('Get lista salas').all();\n\n// Extraer los códigos de sala en un array\nconst salas = itemsSalas.map(item => item.json['Salas']); \n// Ajusta la clave según cómo venga tu JSON\n\n// Confirmar existencia\nconst existe = salas.includes(salaEliminar);\n\n// Buscar la fila completa que coincide\nlet filaCoincidente = null;\nfor (const item of itemsSalas) {\n  // Ajusta la clave según tu estructura real\n  if (item.json['Salas'] === salaEliminar) {\n    filaCoincidente = item.json;\n    break;\n  }\n}\n\nreturn [\n  {\n    json: {\n      salaEliminar,\n      existe,\n      salas,\n      filaCoincidente // aquí devuelves la fila completa si existe\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        0
      ],
      "id": "4cba7a44-39b0-4583-beff-b3e375430c03",
      "name": "Buscar sala"
    },
    {
      "parameters": {
        "jsCode": "const sala = $('Buscar sala').first().json.filaCoincidente.Salas;\nconst participantes = $('Buscar sala').first().json.filaCoincidente.MaxParticipantes;\nconst apertura = $('Buscar sala').first().json.filaCoincidente['Hora apertura'];\nconst cierre = $('Buscar sala').first().json.filaCoincidente['Hora cierre'];\nconst ubicacion = $('Buscar sala').first().json.filaCoincidente.Ubicacion;\n\nconst clientId = '36788e45-7a1d-4015-8040-9e3e065953fc';\nconst redirectUri = encodeURIComponent('https://jeremy-pily-prediligently.ngrok-free.dev/webhook-test/oauth2-credential/callback/eliminar');\nconst scope = encodeURIComponent('https://graph.microsoft.com/User.Read');\nconst state = encodeURIComponent($('Get datos solicitud').first().json['Marca temporal']);\n\n\n\nconst html = `\n  <html>\n    <body>\n      <p>Usted está intentando eliminar esta sala:</p>\n      <table border=\"1\" cellpadding=\"5\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n        <tr>\n          <th>Código de sala</th>\n          <td>${sala}</td>\n        </tr>\n        <tr>\n          <th>Capacidad máxima</th>\n          <td>${participantes}</td>\n        </tr>\n        <tr>\n          <th>Hora de apertura</th>\n          <td>${apertura}</td>\n        </tr>\n        <tr>\n          <th>Hora de cierre</th>\n          <td>${cierre}</td>\n        </tr>\n        <tr>\n          <th>Ubicación</th>\n          <td>${ubicacion}</td>\n        </tr>\n      </table>\n      <p>//login.microsoftonline.com/common/oauth2/v2.0/authorize?client_id=${clientId}&response_type=code&redirect_uri=${redirectUri}&scope=${scope}&state=${state}<p>\n    </body>\n  </html>\n`;\n\nreturn [\n  {\n    json: {\n      html\n    }\n  }\n];\n"
      },
