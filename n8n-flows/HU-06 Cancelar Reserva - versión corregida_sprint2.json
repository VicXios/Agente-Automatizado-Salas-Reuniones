    {
      "parameters": {
        "jsCode": "// ID desde el webhook (acepta body.ID o ID plano)\nconst webhook = $('Webhook Cancelar').first().json;\nconst idToCancel = webhook.body?.ID ?? webhook.ID;\nif (!idToCancel) throw new Error('No se recibió ID en el webhook.');\n\n// Filas del Get Row(s)\nconst rows = $input.all();\nlet found = null;\nlet rowNumber = null;\n\nfor (let i = 0; i < rows.length; i++) {\n  const r = rows[i].json;\n  if (r.ID === idToCancel) {\n    found = r;\n    // 1 = header, 2 = primera fila de datos\n    rowNumber = r.rowNumber ?? r.rowIndex ?? (i + 2);\n    break;\n  }\n}\n\nif (!found || !rowNumber || rowNumber < 2) {\n  throw new Error(`No se encontró reserva válida con ID ${idToCancel}`);\n}\n\nreturn [{\n  json: {\n    id: found.ID,\n    sala: found.Sala,\n    email: found.Correo,\n    fecha: found.Fecha,\n    horaInicio: found.HoraInicio,\n    horaFin: found.HoraFin,\n    titulo: found.Titulo,\n    descripcion: found.Descripcion,\n    participantes: found.Participantes,   // puede venir como string JSON\n    idCalendar: found.ID_Calendar,\n    linkCalendar: found.Link_Calendar,\n    rowNumber\n  }\n}];\n"
      },
