    {
      "parameters": {
        "jsCode": "const fechaRaw = $('Webhook').first().json.body.fecha;         // \"1/11/2025\"\nconst inicioRaw = $('Webhook').first().json.body.inicio;       // \"12:00:00 a.m.\"\nconst finRaw = $('Webhook').first().json.body.fin;             // \"6:00:00 p.m.\"\n\n// Convertir fecha de DD/MM/YYYY a YYYY-MM-DD\nfunction normalizarFecha(fecha) {\n  const [dia, mes, año] = fecha.split('/');\n  return `${año}-${mes.padStart(2, '0')}-${dia.padStart(2, '0')}`;\n}\n\n// Convertir hora de 12h a 24h\nfunction convertirHora(hora12) {\n  const [horaMinutos, meridiano] = hora12.toLowerCase().split(/[\\s]+/);\n  let [hora, minutos, segundos] = horaMinutos.split(':').map(Number);\n\n  if (meridiano === 'p.m.' && hora < 12) hora += 12;\n  if (meridiano === 'a.m.' && hora === 12) hora = 0;\n\n  return `${hora.toString().padStart(2, '0')}:${minutos.toString().padStart(2, '0')}:${segundos.toString().padStart(2, '0')}`;\n}\n\nconst fechaISO = normalizarFecha(fechaRaw);     // \"2025-11-01\"\nconst horaInicio = convertirHora(inicioRaw);    // \"00:00:00\"\nconst horaFin = convertirHora(finRaw);          // \"18:00:00\"\nconst zona = \"-03:00\";                          // Chile Summer Time\n\nconst start = `${fechaISO}T${horaInicio}${zona}`;\nconst end = `${fechaISO}T${horaFin}${zona}`;\n\nreturn [{ start, end }];\n"
      },
