    {
      "parameters": {
        "jsCode": "const correo = $input.first().json['Correo administrador'];\nconst nuevaSala = $input.first().json['Codigo de sala unico'];\nconst capacidad = $input.first().json['Capacidad maxima de participantes'];\nconst apertura = $input.first().json['Hora de apertura'];\nconst cierre = $input.first().json['Hora de cierre'];\nconst ubicacion = $input.first().json['Ubicacion (piso, edificio,sector)'];\nconst eliminarSala = $input.first().json['Codigo sala a eliminar'];\n\n// Función auxiliar para verificar si un campo tiene valor\nfunction tieneDato(valor) {\n  return valor !== undefined && valor !== null && String(valor).trim() !== '';\n}\n\nlet tipoSolicitud = \"incompleto\";\n\n// Caso AGREGAR: todos los campos de agregar tienen datos y eliminarSala está vacío\nif (\n  tieneDato(correo) &&\n  tieneDato(nuevaSala) &&\n  tieneDato(capacidad) &&\n  tieneDato(apertura) &&\n  tieneDato(cierre) &&\n  tieneDato(ubicacion) &&\n  !tieneDato(eliminarSala)\n) {\n  tipoSolicitud = \"agregar\";\n}\n\n// Caso ELIMINAR: correo y eliminarSala tienen datos y el resto está vacío\nelse if (\n  tieneDato(correo) &&\n  tieneDato(eliminarSala) &&\n  !tieneDato(nuevaSala) &&\n  !tieneDato(capacidad) &&\n  !tieneDato(apertura) &&\n  !tieneDato(cierre) &&\n  !tieneDato(ubicacion)\n) {\n  tipoSolicitud = \"eliminar\";\n}\n\n// En cualquier otro escenario → incompleto\nreturn [\n  {\n    json: {\n      ...$input.first().json,\n      tipoSolicitud\n    }\n  }\n];"
      },
