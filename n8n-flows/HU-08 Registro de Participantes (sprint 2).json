    {
      "parameters": {
        "functionCode": "// --- Obtener datos, sea directo o dentro de body ---\nconst data = $json.body ? $json.body : $json;\nlet participantes = data.participantes;\n\n// Si no hay participantes, error\nif (!participantes || participantes.length === 0) {\n  return [{\n    json: {\n      error: true,\n      mensaje: 'Debe incluir al menos un participante en el campo \"participantes\".'\n    }\n  }];\n}\n\n// Si llega como texto separado por comas\nif (!Array.isArray(participantes)) {\n  participantes = typeof participantes === 'string'\n    ? participantes.split(',').map(c => c.trim())\n    : [];\n}\n\n// Validación de formato\nconst regexCorreo = /^[\\w.-]+@[\\w.-]+\\.[A-Za-z]{2,}$/;\nconst validos = participantes.filter((c, i, self) => regexCorreo.test(c) && self.indexOf(c) === i);\nconst invalidos = participantes.filter(c => !regexCorreo.test(c));\n\n// Si hay inválidos, error\nif (invalidos.length > 0) {\n  return [{\n    json: {\n      error: true,\n      mensaje: `❌ Correos inválidos detectados: ${invalidos.join(', ')}`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...data,\n    participantesValidos: validos,\n    totalParticipantes: validos.length\n  }\n}];\n"
      },
      "id": "4243717f-e064-446a-83e2-2bdabd4f0519",
      "name": "Validar Participantes",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -1584,
        64
      ]
    },
    {
      "parameters": {
        "functionCode": "// --- Revisión de disponibilidad (versión definitiva) ---\n\n// Todas las reservas existentes (desde Google Sheets)\nconst reservas = items.map(item => item.json);\n\n// Nueva reserva (desde el Webhook)\nconst nueva = $item(0).$node[\"Webhook - Recibir Reserva\"].json.body;\n\n// --- Función para limpiar nombres de sala ---\nfunction limpiarSala(valor) {\n  return valor\n    ? valor\n        .toString()\n        .normalize('NFD')\n        .replace(/[\\u0300-\\u036f]/g, '')\n        .replace(/\\u00A0/g, ' ')\n        .trim()\n        .toLowerCase()\n        .replace(/\\s+/g, '')\n        .replace(/[^a-z0-9]/g, '')\n    : '';\n}\n\n// --- Normalización de datos nuevos ---\nconst salaNueva = limpiarSala(nueva.sala || '');\nconst fechaNueva = (nueva.fecha || '').toString().trim();\nconst horaInicioNueva = (nueva.horaInicio || '').toString().trim();\nconst horaFinNueva = (nueva.horaFin || '').toString().trim();\n\n// --- Función para convertir HH:MM a minutos ---\nfunction toMinutes(hora) {\n  if (!hora) return 0;\n  const [h, m] = hora.split(':').map(Number);\n  return (h || 0) * 60 + (m || 0);\n}\n\nlet conflicto = false;\nlet conflictoData = null;\n\n// --- Verificar conflicto de sala y horario ---\nfor (const item of reservas) {\n  const salaExistente = limpiarSala(item.Sala || '');\n  const fechaExistente = (item.Fecha || '').toString().trim();\n  const horaInicioExistente = (item.HoraInicio || '').toString().trim();\n  const horaFinExistente = (item.HoraFin || '').toString().trim();\n\n  // Comparar solo si es la misma sala y fecha\n  if (salaExistente === salaNueva && fechaExistente === fechaNueva) {\n    const inicioNueva = toMinutes(horaInicioNueva);\n    const finNueva = toMinutes(horaFinNueva);\n    const inicioExistente = toMinutes(horaInicioExistente);\n    const finExistente = toMinutes(horaFinExistente);\n\n    // Detectar solapamiento de horarios\n    if (inicioNueva < finExistente && finNueva > inicioExistente) {\n      conflicto = true;\n      conflictoData = item;\n      break;\n    }\n  }\n}\n\n// --- Salida final ---\nreturn [\n  {\n    json: {\n      disponible: !conflicto,\n      mensaje: conflicto\n        ? `❌ La sala ya está reservada para esa fecha (${fechaNueva}) entre ${horaInicioNueva} y ${horaFinNueva}.`\n        : '✅ La sala está disponible para reservar.',\n      conflicto: conflictoData,\n      debug: {\n        salaNueva,\n        fechaNueva,\n        horaInicioNueva,\n        horaFinNueva,\n        totalFilasLeidas: reservas.length\n      }\n    }\n  }\n];\n"
      },
